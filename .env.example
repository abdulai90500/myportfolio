# =============================================
# ENVIRONMENT VARIABLES - TEMPLATE
# =============================================
# Copy this file to .env.local for local development
# Add these variables in your Vercel project settings too

# --- Contact Form (Optional) ---
# If you want to send real emails via the contact form,
# add a service like EmailJS or Resend:
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# --- Site Config ---
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app
NEXT_PUBLIC_SITE_NAME=Abdulai S. Kamara Portfolio
